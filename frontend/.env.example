# Frontend Environment Variables
# Copy this to .env and fill in your values

# API Base URL (backend server URL)
# Development: http://localhost:5000
# Production: Your Render backend URL (e.g., https://ecocollect-backend.onrender.com)
VITE_API_URL=http://localhost:5000

# Stripe Public Key
# Development: pk_test_xxx
# Production: Use your live key from Stripe Dashboard
VITE_STRIPE_PUBLIC_KEY=pk_test_placeholder

# Backend URL for Socket.io (same as API URL but without /api)
# Development: http://localhost:5000
# Production: Your Render backend URL
VITE_BACKEND_URL=http://localhost:5000